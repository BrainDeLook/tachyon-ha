#!/bin/sh
set -eu

OPTIONS_FILE=/data/options.json
DATA_DIR=/data/tachyon

# Keep Tachyon state in Home Assistant's persistent add-on data directory.
# The upstream image used to declare /var/lib/tachyon as a Docker volume;
# this migration also handles data copied from that older layout.
if [ ! -L /var/lib/tachyon ]; then
  mkdir -p "$DATA_DIR"
  if [ -d /var/lib/tachyon ] && [ "$(find /var/lib/tachyon -mindepth 1 -print -quit 2>/dev/null)" ]; then
    cp -a /var/lib/tachyon/. "$DATA_DIR"/
    if mv /var/lib/tachyon /var/lib/tachyon.legacy 2>/dev/null; then
      ln -s "$DATA_DIR" /var/lib/tachyon
      echo "[INFO] Moved legacy Tachyon data to /var/lib/tachyon.legacy and switched to $DATA_DIR"
    else
      echo "[WARN] /var/lib/tachyon is busy; data was copied to $DATA_DIR, but the original directory was left untouched"
    fi
  elif [ -d /var/lib/tachyon ] && rmdir /var/lib/tachyon 2>/dev/null; then
    ln -s "$DATA_DIR" /var/lib/tachyon
  elif [ ! -e /var/lib/tachyon ]; then
    ln -s "$DATA_DIR" /var/lib/tachyon
  else
    echo "[WARN] Cannot replace /var/lib/tachyon; keeping the existing directory"
  fi
fi

json_value() {
  key="$1"
  default="$2"
  if [ ! -f "$OPTIONS_FILE" ]; then
    printf '%s' "$default"
    return
  fi
  value=$(sed -n "s/.*\"${key}\"[[:space:]]*:[[:space:]]*\(true\|false\|\"[^\"]*\"\).*/\1/p" "$OPTIONS_FILE" | head -n 1)
  value=${value:-$default}
  value=${value#\"}
  value=${value%\"}
  printf '%s' "$value"
}

export DEBUG="$(json_value debug false)"
export UPLOAD_MAX_SIZE="$(json_value upload_max_size 25M)"
export MEMORY_LIMIT="$(json_value memory_limit 128M)"
export SECURE_COOKIES="$(json_value secure_cookies true)"

# Tachyon inherits SnappyMail's per-domain JSON format.  Seed Gmail's
# official IMAPS/SMTPS endpoints once, without overwriting user changes.
if [ "$(json_value preconfigure_gmail true)" = "true" ]; then
  GMAIL_DOMAIN_DIR=/var/lib/tachyon/_data_/_default_/domains
  GMAIL_DOMAIN_FILE="$GMAIL_DOMAIN_DIR/gmail.com.json"
  if [ ! -e "$GMAIL_DOMAIN_FILE" ]; then
    mkdir -p "$GMAIL_DOMAIN_DIR"
    cat > "$GMAIL_DOMAIN_FILE" <<'JSON'
{
    "IMAP": {
        "host": "imap.gmail.com",
        "port": 993,
        "type": 2,
        "timeout": 300,
        "shortLogin": false,
        "lowerLogin": true,
        "sasl": ["PLAIN", "LOGIN", "XOAUTH2"],
        "ssl": {"verify_peer": true, "verify_peer_name": true, "allow_self_signed": false, "SNI_enabled": true}
    },
    "SMTP": {
        "host": "smtp.gmail.com",
        "port": 465,
        "type": 2,
        "timeout": 60,
        "shortLogin": false,
        "lowerLogin": true,
        "sasl": ["PLAIN", "LOGIN", "XOAUTH2"],
        "ssl": {"verify_peer": true, "verify_peer_name": true, "allow_self_signed": false, "SNI_enabled": true},
        "useAuth": true,
        "setSender": true,
        "usePhpMail": false
    },
    "Sieve": {"enabled": false},
    "whiteList": ""
}
JSON
    echo "[INFO] Seeded Gmail IMAP/SMTP defaults"
  fi
fi

exec /entrypoint.sh
